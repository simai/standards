{
  "type": "object",
  "properties": {
    "format": {
      "const": "standard-contract-journal"
    },
    "formatVersion": {
      "const": "lifecycle-draft-1"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "release": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "id",
              "version",
              "sha256"
            ],
            "additionalProperties": false
          },
          "status": {
            "enum": [
              "draft",
              "active",
              "deprecated",
              "withdrawn"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "decisionSource": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "sequence",
          "release",
          "status",
          "reason",
          "decisionSource"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "formatVersion",
    "entries"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

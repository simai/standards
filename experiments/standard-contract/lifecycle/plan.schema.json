{
  "type": "object",
  "properties": {
    "format": {
      "const": "standard-contract-update-plan"
    },
    "formatVersion": {
      "const": "lifecycle-draft-1"
    },
    "sourceProjectSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "version",
              "sha256",
              "path"
            ],
            "additionalProperties": false
          },
          "targetVersion": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "replacement": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "source",
          "targetVersion"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "formatVersion",
    "sourceProjectSha256",
    "changes"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

{
  "type": "object",
  "properties": {
    "format": {
      "const": "standard-contract-declaration"
    },
    "formatVersion": {
      "const": "1.0"
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "standards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https?://[^\\s]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "version",
          "path",
          "sha256"
        ],
        "additionalProperties": false,
        "dependentRequired": {
          "path": [
            "sha256"
          ],
          "sha256": [
            "path"
          ]
        }
      }
    }
  },
  "required": [
    "format",
    "formatVersion",
    "target",
    "kind",
    "standards"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

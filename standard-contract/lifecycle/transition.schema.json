{
  "type": "object",
  "properties": {
    "format": {
      "const": "standard-contract-transition"
    },
    "formatVersion": {
      "const": "1.0"
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "category": {
      "enum": [
        "patch",
        "minor",
        "major"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "requiredChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "replacements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false
      }
    },
    "assessment": {
      "type": "object",
      "properties": {
        "reader": {
          "enum": [
            "compatible",
            "incompatible",
            "needs-review"
          ]
        },
        "objects": {
          "enum": [
            "compatible",
            "incompatible",
            "needs-review"
          ]
        },
        "decisionSource": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "reader",
        "objects",
        "decisionSource"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "formatVersion",
    "source",
    "target",
    "category",
    "rationale",
    "requiredChecks",
    "replacements",
    "assessment"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simai.io/schema/change-journal.v1.json",
  "x-simai-version": "1.0.0",
  "title": "SIMAI change journal",
  "description": "The append-only chronology of public changes a consumer acts on (standard simai.change-lifecycle, core). Kinds and rewrites come from the profile. The Framework journal (simai.change-journal schema_version 1, or simai.change-journal.v1) is read as this format with profile framework.",
  "oneOf": [
    {
      "$ref": "#/$defs/core"
    },
    {
      "$ref": "https://simai.io/schema/framework/change-journal.v1.json"
    }
  ],
  "$defs": {
    "core": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schema_version",
        "profile",
        "policy",
        "records"
      ],
      "properties": {
        "schema": {
          "const": "simai.change-journal"
        },
        "schema_version": {
          "const": 1
        },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
            }
          },
          "description": "The profile and its version (simai.linkage profile-declared)."
        },
        "policy": {
          "type": "string"
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "recorded_on",
              "stage",
              "kind",
              "summary",
              "items",
              "deprecated_on",
              "remove_after",
              "rewrite"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"
              },
              "recorded_on": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "stage": {
                "enum": [
                  "compat",
                  "removed"
                ]
              },
              "kind": {
                "type": "string",
                "pattern": "^[a-z][a-z-]*$"
              },
              "summary": {
                "type": "string",
                "minLength": 20
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "from"
                  ],
                  "properties": {
                    "unit": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 260,
                      "pattern": "^([a-z0-9][a-z0-9._/-]*:)?[a-z][a-z0-9-]*([./][a-z0-9][a-z0-9._-]*)+$",
                      "description": "An id, or <source>:<id> for a unit of another source."
                    },
                    "from": {
                      "type": "string"
                    },
                    "to": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "match": {
                      "type": "string"
                    }
                  }
                }
              },
              "deprecated_on": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "remove_after": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "extended_to": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "extension_reason": {
                "type": "string"
              },
              "removed_on": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "rewrite": {
                "type": "string",
                "pattern": "^[a-z][a-z-]*$"
              },
              "examples": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "before": {
                    "type": "string"
                  },
                  "after": {
                    "type": "string"
                  }
                }
              },
              "manual": {
                "type": "string"
              },
              "owner": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "by": {
                "type": "string",
                "description": "Mirror: the act of the original source."
              }
            }
          }
        }
      }
    }
  }
}
